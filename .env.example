# === Calm Money Daily — copy to .env and fill in ===
# Phase 1 ships placeholders only. Add the Gemini key before Phase 2,
# the Facebook token before Phase 5.

# --- Gemini (required for generation + research) ---
GEMINI_API_KEY=

# --- Facebook Graph API (required for publishing, Phase 5) ---
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=          # long-lived Page access token (~60 day expiry)
FB_GRAPH_VERSION=v21.0         # Graph API version

# --- Timezones ---
TIMEZONE_DHAKA=Asia/Dhaka
TIMEZONE_TARGET=America/New_York

# --- Paths (relative to project root; defaults are fine) ---
SQLITE_PATH=./data/calm_money.db
LOG_PATH=./logs/calm_money.log

# --- Gemini model routing (free-tier-safe defaults) ---
# Mini-blog anchor wants 2.5-pro, but on the free tier pro/grounding quota
# may be unavailable. MINIBLOG_ALLOW_PRO=0 forces flash everywhere.
MODEL_FLASH=gemini-2.5-flash
MODEL_PRO=gemini-2.5-pro
MODEL_LITE=gemini-2.5-flash-lite
MINIBLOG_ALLOW_PRO=0           # 0 = use flash for mini-blogs (free tier); 1 = use pro
RESEARCH_USE_GROUNDING=1       # 1 = Google Search grounding; 0 = ungrounded fallback

# --- Operational ---
KILL_SWITCH=0                  # 1 = pause all publishing without stopping the process
# Or pause without editing .env: create this file to pause, delete it to resume.
KILL_SWITCH_FILE=./data/KILL_SWITCH
DRY_RUN=0                     # 1 = render + store but never call the FB API

# --- Telegram alerts (optional) ---
# If both are set, ERROR-level events (publish failures, research failures,
# slots that can't produce a compliant post) are sent here automatically.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
